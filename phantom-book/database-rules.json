{
  "rules": {
    "books": {
      ".read": true,
      ".indexOn": ["createdAt", "category"],
      "$bookId": {
        ".write": "auth != null && auth.uid === 'OZ5sD1Lz8NNDJXoDifhfRxtQpKX2'",
        ".validate": "newData.hasChildren(['name','description','category','pdfUrl','storagePath','createdAt','publishedBy'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "category": { ".validate": "newData.val() === 'free' || newData.val() === 'premium'" },
        "pdfUrl": { ".validate": "newData.isString() && newData.val().length > 0" },
        "storagePath": { ".validate": "newData.isString() && newData.val().matches(/^books\\/[A-Za-z0-9_-]+\\/[0-9]+-[^/]+$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "publishedBy": { ".validate": "newData.val() === auth.uid" }
      }
    }
  }
}